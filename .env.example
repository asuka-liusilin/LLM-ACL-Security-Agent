# === 模型服务配置（仅后端读取，前端永远不会拿到）===
# 留空表示只使用演示模式；填写后可选择 API 模式
LLM_API_KEY=
# OpenAI 兼容接口的基础地址（示例：DeepSeek / 通义 / OpenAI）
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名称
LLM_MODEL=deepseek-chat
# 请求超时（秒）
LLM_TIMEOUT=30

# === Agent 演示动画 ===
# 每个步骤之间的停顿（秒），设为 0 可关闭，便于快速测试
AGENT_STEP_DELAY=0.18

# === 跨域 ===
# 前端开发服务器地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
